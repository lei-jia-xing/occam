#!/usr/bin/env bash
set -eo pipefail

RUNNER=""
if ! command -v fourmolu &>/dev/null; then
    if command -v nix &>/dev/null; then
        RUNNER="nix develop --command"
    fi
fi

echo "==> [pre-commit] Checking formatting with fourmolu..."
HS_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.hs$' || true)

if [ -n "$HS_FILES" ]; then
    if command -v fourmolu &>/dev/null; then
        fourmolu --mode check $HS_FILES
    elif [ -n "$RUNNER" ]; then
        $RUNNER fourmolu --mode check $HS_FILES
    else
        echo "Warning: fourmolu not found, skipping format check."
    fi
fi

echo "==> [pre-commit] Running hlint..."
if command -v hlint &>/dev/null; then
    hlint src app test
elif [ -n "$RUNNER" ]; then
    $RUNNER hlint src app test
fi

echo "==> [pre-commit] All checks passed!"
