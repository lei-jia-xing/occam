FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    postgresql \
    postgresql-contrib \
    mysql-server \
    openjdk-17-jdk-headless \
    maven \
    creduce \
    python3 \
    python3-dev \
    python3-pip \
    python3-venv \
    libpq-dev \
    jq \
    curl \
    git \
    make \
    gcc \
    libtree-sitter-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV SQLANCER_SOURCE=/opt/sqlancer/a7d60ee450e6a22ca38599c14e984a49773f4745
ENV SQLREDUCE_SOURCE=/opt/sqlreduce/568c8a9a31601ead7128d0b067658b4d5a26821d

WORKDIR /workspace

ENTRYPOINT ["/workspace/harness/docker_entrypoint.sh"]
