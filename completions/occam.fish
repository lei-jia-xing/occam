# @generated by usage-cli from occam.usage.kdl

# if "usage" is not installed show an error
if ! type -P usage &> /dev/null
    echo >&2
    echo "Error: usage CLI not found. This is required for completions to work in occam." >&2
    echo "See https://usage.jdx.dev for more information." >&2
    return 1
end

set _usage_spec_occam 'name Occam
bin occam
version "0.1.0"
about "Occam: Dependency-Aware SQL Test Case Minimizer"
flag --oracle help="Interestingness predicate command (SQL on stdin; exit 0 accepts)" required=#true {
    arg <COMMAND>
}
flag "-o --out" help="Directory where reduced artifacts will be written, or \'-\' for stdout" default=occam-out {
    arg <DIR>
}
flag --reset help="Lightweight state reset command (e.g. dropdb/createdb)" {
    arg <COMMAND>
}
flag --timeout help="Per-execution timeout in seconds" default="10.0" {
    arg <SECONDS>
}
flag --log-level help="Log severity level" default=info {
    arg <LEVEL> {
        choices debug info warn error
    }
}
flag --log-format help="Log output format" default=text {
    arg <FORMAT> {
        choices text json
    }
}
flag "-v --verbose" help="Enable verbose debug output (equivalent to --log-level debug)"
flag "-q --quiet" help="Suppress info logs and banners (equivalent to --log-level error)"
flag --budget help="Shared wall-clock cap including initial check, reduction, and audit" {
    arg <SECONDS>
}
flag --max-oracle-executions help="Maximum uncached oracle attempts including initial check and validation" {
    arg <N>
}
flag --slicing help="Enable dependency slicing"
flag --no-slicing help="Disable dependency slicing"
flag --closure help="Enable dependency closure"
flag --no-closure help="Disable dependency closure"
flag --intra-statement help="Enable intra-statement reductions"
flag --no-intra-statement help="Disable intra-statement reductions"
flag --unrestricted help="Enable unrestricted reductions"
flag --no-unrestricted help="Disable unrestricted reductions"
flag --cache help="Enable candidate caching"
flag --no-cache help="Disable candidate caching"
flag --dialect help="SQL dependency dialect" default=generic {
    arg <DIALECT> {
        choices generic postgresql mysql sqlite duckdb clickhouse oracle ansi bigquery databricks hive mssql redshift snowflake spark teradata
    }
}
arg <INPUT.sql> help="Path to fuzz SQL input, or \'-\' for stdin"
'
set -l spec_dir (if set -q XDG_CACHE_HOME; echo $XDG_CACHE_HOME; else; echo $HOME/.cache; end)/usage
test -d "$spec_dir"; or mkdir -p -m 700 "$spec_dir"
set -l spec_file "$spec_dir/usage__usage_spec_occam.spec"
echo $_usage_spec_occam > "$spec_file"

# stderr is discarded: a line that doesn't parse (`occam help <Tab>`) makes
# complete-word fail, and its error would be printed over the prompt.
# The word being completed is cut at the cursor (`-c`) and unquoted, so
# `'prod<Tab>` and `sub\ dir/<Tab>` match the same values as their bare
# spellings; fish re-quotes whatever it inserts.
if commandline -x >/dev/null 2>&1
    complete -xc occam -a "(command usage complete-word --shell fish -f \"$spec_file\" -- (commandline -xpc) (commandline -ct | string unescape) 2>/dev/null)"
else
    complete -xc occam -a "(command usage complete-word --shell fish -f \"$spec_file\" -- (commandline -opc) (commandline -ct | string unescape) 2>/dev/null)"
end
