cabal-version:      3.0
name:               occam
version:            0.1.0.0
synopsis:           A Dependency-Aware Minimizer for Multi-Statement SQL
description:        Occam is a state- and dependency-aware test case reducer for fuzz-generated multi-statement SQL using external interestingness predicates.
license:            MIT
license-file:       LICENSE
author:             Hunter
maintainer:         leij49456@gmail.com
category:           Development, Database, Testing
build-type:         Simple
extra-doc-files:    README.md
data-files:         benchmarks/corpus/*.sql
extra-source-files:
    test/seeds/*.sql
source-repository head
    type:     git
    location: https://github.com/Hunter/occam

common warnings
    ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates
                 -Wincomplete-uni-patterns -Wmissing-export-lists
                 -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints

common language
    default-language: GHC2021
    default-extensions:
        BlockArguments
        DataKinds
        DeriveAnyClass
        DerivingStrategies
        DisambiguateRecordFields
        ExplicitNamespaces
        GADTs
        LambdaCase
        MonoLocalBinds
        OverloadedStrings
        RecordWildCards
        RoleAnnotations

common core-deps
    build-depends:    base >= 4.18 && < 5
                    , bytestring >= 0.11 && < 0.13
                    , text >= 2.0 && < 2.2
                    , containers >= 0.6 && < 0.9
                    , transformers >= 0.5 && < 0.7

common io-deps
    build-depends:    directory >= 1.3 && < 1.4
                    , filepath >= 1.4 && < 1.6
                    , aeson >= 2.0 && < 2.4

    if !os(windows)
        build-depends: unix >= 2.7 && < 2.9

common rts-threaded
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N -A32m"

common rts-bench
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-T -A32m"

