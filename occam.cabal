cabal-version:      3.0
name:               occam
version:            0.1.0.0
synopsis:           A Dependency-Aware Minimizer for Multi-Statement SQL Crashes
description:        Occam is a state- and dependency-aware test case reducer for multi-statement SQL crashes.
license:            MIT
license-file:       LICENSE
author:             Hunter
maintainer:         leij49456@gmail.com
category:           Development, Database, Testing
build-type:         Simple
extra-doc-files:    README.md

common warnings
    ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates
                 -Wincomplete-uni-patterns -Wmissing-export-lists
                 -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints

library
    import:           warnings
    exposed-modules:  Occam
                    , Occam.Cache
                    , Occam.Core
                    , Occam.Dependency
                    , Occam.Oracle
                    , Occam.Reducer
                    , Occam.Slicer
                    , Occam.TreeSitter
    build-depends:    base >= 4.18 && < 5
                    , bytestring >= 0.11
                    , text >= 2.0
                    , containers >= 0.6
                    , process >= 1.6
                    , filepath >= 1.4
                    , directory >= 1.3
                    , aeson >= 2.0
                    , time >= 1.12
    hs-source-dirs:   src
    default-language: GHC2021
    default-extensions:
        OverloadedStrings
        RecordWildCards
        LambdaCase
    c-sources:        cbits/occam_ts.c
                    , cbits/tree-sitter-sql/parser.c
                    , cbits/tree-sitter-sql/scanner.c
    include-dirs:     cbits
                    , cbits/tree-sitter-sql
    pkgconfig-depends: tree-sitter
    cc-options:       -O1 -fPIC

executable occam
    import:           warnings
    main-is:          Main.hs
    build-depends:    base >= 4.18 && < 5
                    , occam
                    , bytestring
                    , text
                    , directory
                    , filepath
                    , time
                    , optparse-applicative
                    , aeson >= 2.0
    hs-source-dirs:   app
    default-language: GHC2021
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N

executable occam-eval
    import:           warnings
    main-is:          Main.hs
    other-modules:    Baseline
                    , Benchmark
    hs-source-dirs:   bench
    build-depends:    base >= 4.18 && < 5
                    , occam
                    , bytestring
                    , text
                    , containers
                    , directory
                    , filepath
                    , time
                    , aeson
                    , optparse-applicative
    default-language: GHC2021
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N

test-suite occam-fuzz
    import:           warnings
    default-language: GHC2021
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    other-modules:    Fuzz
    main-is:          FuzzMain.hs
    build-depends:    base >= 4.18 && < 5
                    , occam
                    , bytestring
                    , text
                    , containers
                    , tasty
                    , tasty-quickcheck
                    , QuickCheck >= 2.14
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N

test-suite occam-test
    import:           warnings
    default-language: GHC2021
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test bench
    other-modules:    Baseline
                    , Benchmark
                    , Fuzz
    main-is:          Spec.hs
    build-depends:    base >= 4.18 && < 5
                    , occam
                    , bytestring
                    , text
                    , containers
                    , directory
                    , filepath
                    , process
                    , optparse-applicative
                    , tasty
                    , tasty-hunit
                    , tasty-golden
                    , tasty-quickcheck
                    , QuickCheck
                    , time
                    , aeson
