cabal-version:      3.0
name:               occam
version:            0.1.0.0
synopsis:           A Dependency-Aware Minimizer for Multi-Statement SQL
description:        Occam is a state- and dependency-aware test case reducer for fuzz-generated multi-statement SQL using external interestingness predicates.
license:            MIT
license-file:       LICENSE
author:             Hunter
maintainer:         leij49456@gmail.com
category:           Development, Database, Testing
build-type:         Simple
extra-doc-files:    README.md
data-files:         benchmarks/corpus/*.sql
extra-source-files:
    test/seeds/*.sql
source-repository head
    type:     git
    location: https://github.com/Hunter/occam

common warnings
    ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates
                 -Wincomplete-uni-patterns -Wmissing-export-lists
                 -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints
                 -O2

common language
    default-language: GHC2024
    default-extensions:
        BlockArguments
        DeriveAnyClass
        LambdaCase
        OverloadedStrings
        RecordWildCards

common core-deps
    build-depends:    base >= 4.18 && < 5
                    , bytestring >= 0.11 && < 0.13
                    , text >= 2.0 && < 2.2
                    , containers >= 0.6 && < 0.9
                    , transformers >= 0.5 && < 0.7

common io-deps
    build-depends:    directory >= 1.3 && < 1.4
                    , filepath >= 1.4 && < 1.6
                    , aeson >= 2.0 && < 2.4

    if !os(windows)
        build-depends: unix >= 2.7 && < 2.9

common rts-threaded
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N -A32m"

common rts-bench
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-T -A32m"

library
    import:           warnings, language, core-deps, io-deps
    exposed-modules:  Occam
                    , Occam.AtomicFile
                    , Occam.Cache
                    , Occam.Certificate
                    , Occam.Core
                    , Occam.Facts
                    , Occam.Dependency
                    , Occam.Evaluation
                    , Occam.Logger
                    , Occam.Metrics
                    , Occam.Oracle
                    , Occam.Proposals
                    , Occam.Reducer
                    , Occam.Slicer
                    , Occam.Frontend.AST
                    , Occam.Frontend.Columns
                    , Occam.Frontend.Context
                    , Occam.Frontend.Edits
                    , Occam.Frontend.Lexer
                    , Occam.Frontend.OracleProof
                    , Occam.Frontend.Parser
                    , Occam.Frontend.Pipeline
                    , Occam.Frontend.Semantics
                    , Occam.Frontend.Span
                    , Occam.Frontend.Splitter
                    , Occam.Parser
                    , Occam.Parser.Dialect
                    , Occam.Pool
                    , Occam.UI
                    , Occam.Version
    other-modules:    Paths_occam
                    , Occam.Core.Schema
                    , Occam.Core.Semantics
                    , Occam.Frontend.Columns.Analysis
                    , Occam.Frontend.Columns.Assemble
                    , Occam.Frontend.Columns.Edits
                    , Occam.Frontend.Edits.Core
                    , Occam.Frontend.Edits.DDL
                    , Occam.Frontend.Edits.Expr
                    , Occam.Frontend.Edits.Query
                    , Occam.Frontend.Edits.Stmt
                    , Occam.Frontend.Edits.Tokens
                    , Occam.Frontend.Parser.Core
                    , Occam.Frontend.Parser.DDL
                    , Occam.Frontend.Parser.Expr
                    , Occam.Frontend.Parser.Query
                    , Occam.Frontend.Parser.Stmt
                    , Occam.Frontend.Semantics.DDL
                    , Occam.Frontend.Semantics.DML
                    , Occam.Frontend.Semantics.Expr
                    , Occam.Frontend.Semantics.Pure
                    , Occam.Frontend.Semantics.Query
                    , Occam.Frontend.Semantics.Sequence
                    , Occam.Frontend.Semantics.Session
                    , Occam.Certificate.MissingDef
                    , Occam.Certificate.PrefixCache
                    , Occam.Json
                    , Occam.Parser.Facts
                    , Occam.Parser.Types
                    , Occam.Parser.Validate
                    , Occam.Oracle.Process
                    , Occam.Pool.Types
                    , Occam.Pool.Window
                    , Occam.Dependency.Alter
                    , Occam.Dependency.Barrier
                    , Occam.Dependency.Define
                    , Occam.Dependency.Drop
                    , Occam.Dependency.Enforcement
                    , Occam.Dependency.Query
                    , Occam.Dependency.Rename
                    , Occam.Dependency.Resolve
                    , Occam.Dependency.Session
                    , Occam.Dependency.State
                    , Occam.Dependency.State.Catalog
                    , Occam.Dependency.State.Lenses
                    , Occam.Dependency.Transaction
                    , Occam.Dependency.Write
                    , Occam.Evaluation.Execution
                    , Occam.Evaluation.Types
                    , Occam.Reducer.Audit
                    , Occam.Reducer.Closure
                    , Occam.Reducer.Config
                    , Occam.Reducer.DDMin
                    , Occam.Reducer.DDMin.Core
                    , Occam.Reducer.DDMin.Ranked
                    , Occam.Reducer.Groups
                    , Occam.Reducer.Pipeline
                    , Occam.Reducer.Slice
                    , Occam.Reducer.Statement
                    , Occam.Reducer.Support
                    , Occam.Reducer.Syntax
                    , Occam.Reducer.Syntax.Batches
                    , Occam.Reducer.Syntax.Execute
                    , Occam.Reducer.Syntax.Index
                    , Occam.Reducer.Syntax.Snapshot
    build-depends:    unordered-containers >= 0.2.14 && < 0.3
                    , hashable >= 1.4 && < 1.6
                    , process >= 1.6 && < 1.7
                    , time >= 1.12 && < 1.17
                    , fast-logger >= 3.1 && < 3.3
                    , ansi-terminal >= 1.0 && < 1.2
                    , terminal-progress-bar >= 0.4 && < 0.5
                    , base16-bytestring >= 1.0 && < 1.1
                    , microlens >= 0.4 && < 0.5
                    , safe-exceptions >= 0.1 && < 0.2
                    , temporary >= 1.3 && < 1.4
                    , vector >= 0.13 && < 0.14
    hs-source-dirs:   src

executable occam
    import:           warnings, language, core-deps, io-deps
    main-is:          Main.hs
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N1 -A16m"
    other-modules:    Completion
                    , Options
                    , Options.Parser
                    , Output
                    , Runner
                    , Occam.Oracle.Inline
                    , Occam.Oracle.Result
                    , Occam.Oracle.Sqlite
                    , Occam.Oracle.Sqlite.FFI
                    , Occam.Oracle.Sqlite.Match
                    , Occam.Oracle.Sqlite.Result
                    , Occam.Oracle.DuckDB
                    , Occam.Oracle.DuckDB.Execution
                    , Occam.Oracle.DuckDB.FFI
                    , Occam.Oracle.DuckDB.Replay
                    , Occam.Oracle.DuckDB.Result
    build-depends:    occam
                    , time
                    , optparse-applicative >= 0.17 && < 0.20
                    , direct-sqlite >= 2.3 && < 2.4
                    , safe-exceptions >= 0.1 && < 0.2
    c-sources:        eval-lib/cbits/duckdb_result.c
                      eval-lib/cbits/sqlite_authorizer.c
    hs-source-dirs:   app eval-lib

test-suite occam-fuzz
    import:           warnings, language, core-deps, rts-threaded
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    other-modules:    DialectFuzz
                    , Fuzz
                    , MutationalFuzz
                    , TestSupport
    main-is:          FuzzMain.hs
    build-depends:    occam
                    , directory
                    , tasty
                    , tasty-quickcheck
                    , QuickCheck >= 2.14

test-suite occam-test
    import:           warnings, language, core-deps, io-deps, rts-threaded
    type:             exitcode-stdio-1.0
    c-sources:        eval-lib/cbits/duckdb_result.c
                      eval-lib/cbits/sqlite_authorizer.c
    hs-source-dirs:   test eval-lib
    other-modules:    DialectFuzz
                    , Fuzz
                    , MutationalFuzz
                    , TestSupport
                    , BenchmarkMetricsChecks
                    , CacheChecks
                    , CliChecks
                    , ColumnChecks
                    , DependencyChecks
                    , DependencyChecks.CascadeAndSessionChecks
                    , DependencyChecks.CoreChecks
                    , DependencyChecks.NativeSliceChecks
                    , DependencyChecks.PartitionAndDweChecks
                    , DependencyChecks.SnapshotModelChecks
                    , DependencyChecks.Support
                    , DependencyChecks.ViewAndBarrierChecks
                    , DialectAndControlChecks
                    , DuckDBOracleChecks
                    , EvaluationChecks
                    , FrontendAstInvariants
                    , FrontendChecks
                    , FrontendColumnsChecks
                    , FrontendCorpusChecks
                    , FrontendEditsChecks
                    , FrontendFacadeChecks
                    , FrontendPipelineChecks
                    , FrontendSeedChecks
                    , FrontendSeedLoader
                    , FrontendSemanticsChecks
                    , OracleChecks
                    , ParserChecks
                    , PoolChecks
                    , PoolMetricsChecks
                    , PropertyChecks
                    , ReductionChecks
                    , ReductionChecks.BatchAndDeferralChecks
                    , ReductionChecks.CertificateChecks
                    , ReductionChecks.StatementSearchChecks
                    , ReductionChecks.Support
                    , ReductionChecks.SyntaxAndColumnChecks
                    , SqliteOracleChecks
                    , Occam.Oracle.Inline
                    , Occam.Oracle.Result
                    , Occam.Oracle.Sqlite
                    , Occam.Oracle.Sqlite.FFI
                    , Occam.Oracle.Sqlite.Match
                    , Occam.Oracle.Sqlite.Result
                    , Occam.Oracle.DuckDB
                    , Occam.Oracle.DuckDB.Execution
                    , Occam.Oracle.DuckDB.FFI
                    , Occam.Oracle.DuckDB.Replay
                    , Occam.Oracle.DuckDB.Result
                    , Occam.Benchmark.Metrics
    main-is:          Spec.hs
    build-depends:    occam
                    , process
                    , optparse-applicative
                    , tasty
                    , tasty-hunit
                    , tasty-quickcheck
                    , QuickCheck
                    , time
                    , vector
                    , direct-sqlite >= 2.3 && < 2.4
                    , safe-exceptions >= 0.1 && < 0.2

benchmark occam-bench
    import:           warnings, language, core-deps, io-deps, rts-bench
    type:             exitcode-stdio-1.0
    c-sources:        eval-lib/cbits/duckdb_result.c
                      eval-lib/cbits/sqlite_authorizer.c
    hs-source-dirs:   bench eval-lib
    other-modules:    Occam.Oracle.Result
                    , Occam.Oracle.Inline
                    , ResultBaseline
                    , Occam.Oracle.Sqlite
                    , Occam.Oracle.Sqlite.FFI
                    , Occam.Oracle.Sqlite.Match
                    , Occam.Oracle.Sqlite.Result
                    , Occam.Oracle.DuckDB
                    , Occam.Oracle.DuckDB.Execution
                    , Occam.Oracle.DuckDB.FFI
                    , Occam.Oracle.DuckDB.Replay
                    , Occam.Oracle.DuckDB.Result
                    , Paths_occam
    autogen-modules:  Paths_occam
    main-is:          Main.hs
    build-depends:    occam
                    , tasty-bench >= 0.3 && < 0.6
                    , direct-sqlite >= 2.3 && < 2.4
                    , safe-exceptions >= 0.1 && < 0.2
