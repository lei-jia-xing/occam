    type:             exitcode-stdio-1.0
    hs-source-dirs:   bench
    other-modules:    ResultBaseline
                    , ResultBaseline.Basic
                    , ResultBaseline.Fixtures
                    , ResultBaseline.Runner
                    , ResultBaseline.Statement
                    , ResultBaseline.Syntax
                    , ResultBaseline.SyntaxFixtures
