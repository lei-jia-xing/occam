cabal-version:      3.0
name:               occam
version:            0.1.0.0
synopsis:           A Dependency-Aware Minimizer for Multi-Statement SQL
description:        Occam is a state- and dependency-aware test case reducer for fuzz-generated multi-statement SQL using external interestingness predicates.
license:            MIT
license-file:       LICENSE
author:             Hunter
maintainer:         leij49456@gmail.com
category:           Development, Database, Testing
build-type:         Custom
extra-doc-files:    README.md
data-files:         benchmarks/corpus/*.sql
extra-source-files:
    Setup.hs
    rust/sqlparser-ffi/Cargo.toml
    rust/sqlparser-ffi/Cargo.lock
    rust/sqlparser-ffi/src/*.rs
source-repository head
    type:     git
    location: https://github.com/Hunter/occam

custom-setup
    setup-depends: base >= 4.18 && < 5
                 , Cabal >= 3.12 && < 4
                 , process >= 1.6 && < 1.7
                 , directory >= 1.3 && < 1.4
                 , filepath >= 1.4 && < 1.6

flag static-rust
    description: Link the Rust sqlparser frontend statically for a single self-contained binary (release mode). Default off: link dynamically against the cargo-built cdylib (dev mode).
    manual: True
    default: False
common warnings
    ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates
                 -Wincomplete-uni-patterns -Wmissing-export-lists
                 -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints
                 -O2

common language
    default-language: GHC2024
    default-extensions:
        BlockArguments
        DeriveAnyClass
        LambdaCase
        OverloadedStrings
        RecordWildCards

common core-deps
    build-depends:    base >= 4.18 && < 5
                    , bytestring >= 0.11 && < 0.13
                    , text >= 2.0 && < 2.2
                    , containers >= 0.6 && < 0.9

common io-deps
    build-depends:    directory >= 1.3 && < 1.4
                    , filepath >= 1.4 && < 1.6
                    , aeson >= 2.0 && < 2.4

    if !os(windows)
        build-depends: unix >= 2.7 && < 2.9

common rts-threaded
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N -A32m"

common rts-bench
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-T -A32m"

library
    import:           warnings, language, core-deps, io-deps
    exposed-modules:  Occam
                    , Occam.AtomicFile
                    , Occam.Cache
                    , Occam.Core
                    , Occam.Facts
                    , Occam.Dependency
                    , Occam.Evaluation
                    , Occam.Logger
                    , Occam.Metrics
                    , Occam.Oracle
                    , Occam.Reducer
                    , Occam.Slicer
                    , Occam.Parser
                    , Occam.Pool
                    , Occam.UI
                    , Occam.Version
    other-modules:    Paths_occam
                    , Occam.Json
                    , Occam.Parser.Binary
                    , Occam.Parser.Facts
                    , Occam.Parser.Native
                    , Occam.Parser.Types
                    , Occam.Parser.Validate
                    , Occam.Dependency.Alter
                    , Occam.Dependency.Barrier
                    , Occam.Dependency.Define
                    , Occam.Dependency.Drop
                    , Occam.Dependency.Enforcement
                    , Occam.Dependency.Query
                    , Occam.Dependency.Rename
                    , Occam.Dependency.Resolve
                    , Occam.Dependency.Session
                    , Occam.Dependency.State
                    , Occam.Dependency.Transaction
                    , Occam.Dependency.Write
    build-depends:    binary >= 0.8 && < 0.10
                    , unordered-containers >= 0.2.14 && < 0.3
                    , hashable >= 1.4 && < 1.6
                    , process >= 1.6 && < 1.7
                    , time >= 1.12 && < 1.17
                    , fast-logger >= 3.1 && < 3.3
                    , ansi-terminal >= 1.0 && < 1.2
                    , terminal-progress-bar >= 0.4 && < 0.5
                    , base16-bytestring >= 1.0 && < 1.1
                    , microlens >= 0.4 && < 0.5
                    , safe-exceptions >= 0.1 && < 0.2
                    , temporary >= 1.3 && < 1.4
    hs-source-dirs:   src
    -- Windows is static-only in v1: dynamic cdylib linking is not supported there.
    -- In dynamic mode Setup.hs adds the absolute cargo target dir + rpath at configure time.
    if flag(static-rust) || os(windows)
        extra-bundled-libraries: Coccam_sqlparser
    else
        extra-libraries: occam_sqlparser

    if os(windows)
        extra-libraries: advapi32, ws2_32, userenv, bcrypt, ntdll

executable occam
    import:           warnings, language, core-deps, io-deps, rts-threaded
    main-is:          Main.hs
    other-modules:    Completion
    build-depends:    occam
                    , time
                    , optparse-applicative >= 0.17 && < 0.20
    hs-source-dirs:   app

test-suite occam-fuzz
    import:           warnings, language, core-deps, rts-threaded
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    other-modules:    Fuzz
                    , MutationalFuzz
                    , TestSupport
    main-is:          FuzzMain.hs
    build-depends:    occam
                    , directory
                    , tasty
                    , tasty-quickcheck
                    , QuickCheck >= 2.14

test-suite occam-test
    import:           warnings, language, core-deps, io-deps, rts-threaded
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test eval-lib
    other-modules:    Fuzz
                    , MutationalFuzz
                    , TestSupport
                    , ColumnChecks
                    , DependencyChecks
                    , EvaluationChecks
                    , OracleChecks
                    , PoolChecks
                    , PoolMetricsChecks
                    , ReductionChecks
                    , Occam.Oracle.Sqlite
                    , Occam.Oracle.DuckDB
                    , Occam.Benchmark.Metrics
    main-is:          Spec.hs
    build-depends:    occam
                    , process
                    , optparse-applicative
                    , tasty
                    , tasty-hunit
                    , tasty-quickcheck
                    , QuickCheck
                    , time
                    , direct-sqlite >= 2.3 && < 2.4
                    , safe-exceptions >= 0.1 && < 0.2

benchmark occam-bench
    import:           warnings, language, core-deps, io-deps, rts-bench
    type:             exitcode-stdio-1.0
    hs-source-dirs:   bench eval-lib
    other-modules:    Occam.Oracle.Sqlite
                    , Occam.Oracle.DuckDB
                    , Paths_occam
    autogen-modules:  Paths_occam
    main-is:          Main.hs
    build-depends:    occam
                    , tasty-bench >= 0.3 && < 0.6
                    , direct-sqlite >= 2.3 && < 2.4
                    , safe-exceptions >= 0.1 && < 0.2
