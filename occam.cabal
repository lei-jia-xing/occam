                    , hashable >= 1.4 && < 1.6
                    , process >= 1.6 && < 1.7
                    , time >= 1.12 && < 1.17
                    , fast-logger >= 3.1 && < 3.3
                    , ansi-terminal >= 1.0 && < 1.2
                    , terminal-progress-bar >= 0.4 && < 0.5
                    , base16-bytestring >= 1.0 && < 1.1
                    , optics-core >= 0.4.2 && < 0.5
                    , safe-exceptions >= 0.1 && < 0.2
                    , temporary >= 1.3 && < 1.4
                    , vector >= 0.13 && < 0.14
    hs-source-dirs:   src

library occam-oracle
    import:           warnings, language, core-deps, io-deps
    visibility:       private
    exposed-modules:  Occam.Oracle.Inline
                    , Occam.Oracle.Result
                    , Occam.Oracle.Sqlite
                    , Occam.Oracle.Sqlite.FFI
                    , Occam.Oracle.Sqlite.Match
                    , Occam.Oracle.Sqlite.Result
                    , Occam.Oracle.DuckDB
                    , Occam.Oracle.DuckDB.Execution
                    , Occam.Oracle.DuckDB.FFI
                    , Occam.Oracle.DuckDB.Replay
                    , Occam.Oracle.DuckDB.Result
    build-depends:    occam
                    , direct-sqlite >= 2.3 && < 2.4
                    , safe-exceptions >= 0.1 && < 0.2
    hs-source-dirs:   eval-lib
    c-sources:        eval-lib/cbits/duckdb_result.c
                      eval-lib/cbits/sqlite_authorizer.c

library occam-harness-lib
    import:           warnings, language, core-deps, io-deps
    visibility:       private
    exposed-modules:  Occam.Benchmark.BatchReport
                    , Occam.Benchmark.Metrics
                    , Occam.Harness.BarrierCensus
                    , Occam.Harness.Batch
                    , Occam.Harness.BatchInputs
                    , Occam.Harness.BatchPlan
                    , Occam.Harness.Checkpoints
                    , Occam.Harness.Cli
                    , Occam.Harness.Collect
                    , Occam.Harness.Config
                    , Occam.Harness.Corpus
                    , Occam.Harness.DbmsExec
                    , Occam.Harness.Evidence
                    , Occam.Harness.Oracle
                    , Occam.Harness.Regex
                    , Occam.Harness.Replay
                    , Occam.Harness.Reset
                    , Occam.Harness.Signature
                    , Occam.Harness.SqlancerSanitize
    other-modules:    Occam.Harness.Batch.Jobs
                    , Occam.Harness.Batch.Runner
                    , Occam.Harness.Batch.Types
                    , Occam.Harness.Batch.Workers
                    , Occam.Harness.Evidence.ClickHouse
                    , Occam.Harness.Evidence.Common
                    , Occam.Harness.Evidence.DuckDB
                    , Occam.Harness.Evidence.Mysql
                    , Occam.Harness.Evidence.Postgres
                    , Occam.Harness.Evidence.Sqlite
                    , Occam.Harness.Signature.StackFrame
                    , Occam.Harness.Oracle.Config
                    , Occam.Harness.Oracle.Log
                    , Occam.Harness.Oracle.Probe
                    , Occam.Harness.Oracle.Types
    build-depends:    occam
                    , base16-bytestring >= 1.0 && < 1.1
                    , cryptohash-sha256 >= 0.11 && < 0.12
                    , optparse-applicative >= 0.17 && < 0.20
                    , process >= 1.6 && < 1.7
                    , safe-exceptions >= 0.1 && < 0.2
                    , time
    hs-source-dirs:   eval-lib

executable occam
    import:           warnings, language, core-deps, io-deps
    main-is:          Main.hs
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N1 -A16m"
    other-modules:    Completion
                    , Options
                    , Options.Parser
                    , Output
                    , Runner
    build-depends:    occam
                    , occam:occam-oracle
                    , time
                    , optparse-applicative >= 0.17 && < 0.20
    hs-source-dirs:   app

executable occam-harness
    import:           warnings, language
    main-is:          HarnessMain.hs
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N1 -A16m"
    build-depends:    base >= 4.18 && < 5
                    , occam:occam-harness-lib
    hs-source-dirs:   app

