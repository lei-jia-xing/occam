cabal-version:      3.0
name:               occam
version:            0.1.0.0
synopsis:           A Dependency-Aware Minimizer for Multi-Statement SQL
description:        Occam is a state- and dependency-aware test case reducer for fuzz-generated multi-statement SQL using external interestingness predicates.
license:            MIT
license-file:       LICENSE
author:             Hunter
maintainer:         leij49456@gmail.com
category:           Development, Database, Testing
build-type:         Custom
extra-doc-files:    README.md
extra-source-files:
    Setup.hs
    rust/sqlparser-ffi/Cargo.toml
    rust/sqlparser-ffi/Cargo.lock
    rust/sqlparser-ffi/src/*.rs
source-repository head
    type:     git
    location: https://github.com/Hunter/occam

custom-setup
    setup-depends: base >= 4.18 && < 5
                 , Cabal >= 3.12 && < 4
                 , process >= 1.6 && < 1.7
                 , directory >= 1.3 && < 1.4
                 , filepath >= 1.4 && < 1.6

flag static-rust
    description: Link the Rust sqlparser frontend statically for a single self-contained binary (release mode). Default off: link dynamically against the cargo-built cdylib (dev mode).
    manual: True
    default: False
common warnings
    ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates
                 -Wincomplete-uni-patterns -Wmissing-export-lists
                 -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints

common language
    default-language: GHC2024
    default-extensions:
        BlockArguments
        DeriveAnyClass
        LambdaCase
        OverloadedStrings
        RecordWildCards

library
    import:           warnings, language
    exposed-modules:  Occam
                    , Occam.Cache
                    , Occam.Core
                    , Occam.Facts
                    , Occam.Dependency
                    , Occam.Evaluation
                    , Occam.Logger
                    , Occam.Metrics
                    , Occam.Oracle
                    , Occam.Reducer
                    , Occam.Slicer
                    , Occam.Parser
                    , Occam.Pool
                    , Occam.UI
    other-modules:    Paths_occam
                    , Occam.Dependency.Alter
                    , Occam.Dependency.Barrier
                    , Occam.Dependency.Define
                    , Occam.Dependency.Drop
                    , Occam.Dependency.Enforcement
                    , Occam.Dependency.Query
                    , Occam.Dependency.Rename
                    , Occam.Dependency.Resolve
                    , Occam.Dependency.Session
                    , Occam.Dependency.State
                    , Occam.Dependency.Transaction
                    , Occam.Dependency.Write
    build-depends:    base >= 4.18 && < 5
                    , bytestring >= 0.11 && < 0.13
                    , text >= 2.0 && < 2.2
                    , containers >= 0.6 && < 0.9
                    , process >= 1.6 && < 1.7
                    , filepath >= 1.4 && < 1.6
                    , directory >= 1.3 && < 1.4
                    , aeson >= 2.0 && < 2.4
                    , time >= 1.12 && < 1.17
                    , fast-logger >= 3.1 && < 3.3
                    , ansi-terminal >= 1.0 && < 1.2
                    , terminal-progress-bar >= 0.4 && < 0.5

    if !os(windows)
        build-depends: unix >= 2.7 && < 2.9
    hs-source-dirs:   src
    -- Windows is static-only in v1: dynamic cdylib linking is not supported there.
    -- In dynamic mode Setup.hs adds the absolute cargo target dir + rpath at configure time.
    if flag(static-rust) || os(windows)
        extra-bundled-libraries: Coccam_sqlparser
    else
        extra-libraries: occam_sqlparser

executable occam
    import:           warnings, language
    main-is:          Main.hs
    build-depends:    base >= 4.18 && < 5
                    , occam
                    , bytestring
                    , text
                    , containers
                    , directory
                    , filepath
                    , time
                    , optparse-applicative >= 0.17 && < 0.20
                    , aeson >= 2.0
    hs-source-dirs:   app
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N

test-suite occam-fuzz
    import:           warnings, language
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    other-modules:    Fuzz
                    , MutationalFuzz
    main-is:          FuzzMain.hs
    build-depends:    base >= 4.18 && < 5
                    , occam
                    , bytestring
                    , text
                    , containers
                    , tasty
                    , tasty-quickcheck
                    , QuickCheck >= 2.14
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N

test-suite occam-test
    import:           warnings, language
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    other-modules:    Fuzz
                    , MutationalFuzz
                    , ColumnChecks
                    , DependencyChecks
                    , EvaluationChecks
                    , OracleChecks
                    , PoolChecks
                    , PoolMetricsChecks
                    , ReductionChecks
    main-is:          Spec.hs
    build-depends:    base >= 4.18 && < 5
                    , occam
                    , bytestring
                    , text
                    , containers
                    , directory
                    , filepath
                    , process
                    , optparse-applicative
                    , tasty
                    , tasty-hunit
                    , tasty-quickcheck
                    , QuickCheck
                    , time
                    , aeson
    ghc-options:      -threaded -rtsopts

benchmark occam-bench
    import:           warnings, language
    type:             exitcode-stdio-1.0
    hs-source-dirs:   bench
    main-is:          Main.hs
    build-depends:    base >= 4.18 && < 5
                    , occam
                    , bytestring
                    , text
                    , containers
                    , aeson
                    , directory
                    , filepath
    ghc-options:      -threaded -rtsopts -with-rtsopts=-T
