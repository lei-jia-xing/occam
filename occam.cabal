cabal-version:      3.0
name:               occam
version:            0.1.0.0
synopsis:           A Dependency-Aware Minimizer for Multi-Statement SQL
description:        Occam is a state- and dependency-aware test case reducer for fuzz-generated multi-statement SQL using external interestingness predicates.
license:            MIT
license-file:       LICENSE
author:             Hunter
maintainer:         leij49456@gmail.com
category:           Development, Database, Testing
build-type:         Custom
extra-doc-files:    README.md
extra-source-files:
    Setup.hs
    rust/sqlparser-ffi/Cargo.toml
    rust/sqlparser-ffi/Cargo.lock
    rust/sqlparser-ffi/src/*.rs
source-repository head
    type:     git
    location: https://github.com/Hunter/occam

custom-setup
    setup-depends: base >= 4.18 && < 5
                 , Cabal >= 3.0 && < 4
                 , process >= 1.6 && < 1.7
                 , directory >= 1.3 && < 1.4
                 , filepath >= 1.4 && < 1.6

common warnings
    ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates
                 -Wincomplete-uni-patterns -Wmissing-export-lists
                 -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints

library
    import:           warnings
    exposed-modules:  Occam
                    , Occam.Cache
                    , Occam.Core
                    , Occam.Dependency
                    , Occam.Evaluation
                    , Occam.Logger
                    , Occam.Oracle
                    , Occam.Reducer
                    , Occam.Slicer
                    , Occam.Parser
    build-depends:    base >= 4.18 && < 5
                    , bytestring >= 0.11 && < 0.13
                    , text >= 2.0 && < 2.2
                    , containers >= 0.6 && < 0.8
                    , process >= 1.6 && < 1.7
                    , filepath >= 1.4 && < 1.6
                    , directory >= 1.3 && < 1.4
                    , aeson >= 2.0 && < 2.3
                    , time >= 1.12 && < 1.15
                    , fast-logger >= 3.1 && < 3.3

    if !os(windows)
        build-depends: unix >= 2.7 && < 2.9
    hs-source-dirs:   src
    default-language: GHC2021
    default-extensions:
        OverloadedStrings
        RecordWildCards
        LambdaCase
    extra-bundled-libraries: Coccam_sqlparser

executable occam
    import:           warnings
    main-is:          Main.hs
    build-depends:    base >= 4.18 && < 5
                    , occam
                    , bytestring
                    , text
                    , containers
                    , directory
                    , filepath
                    , time
                    , optparse-applicative >= 0.17 && < 0.19
                    , aeson >= 2.0
    hs-source-dirs:   app
    default-language: GHC2021
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N

executable occam-eval
    import:           warnings
    main-is:          Main.hs
    other-modules:    Baseline
                    , Benchmark
    hs-source-dirs:   bench
    build-depends:    base >= 4.18 && < 5
                    , occam
                    , bytestring
                    , text
                    , containers
                    , directory
                    , filepath
                    , time
                    , aeson
                    , optparse-applicative >= 0.17 && < 0.19
    default-language: GHC2021
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N

test-suite occam-fuzz
    import:           warnings
    default-language: GHC2021
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    other-modules:    Fuzz
                    , MutationalFuzz
    main-is:          FuzzMain.hs
    build-depends:    base >= 4.18 && < 5
                    , occam
                    , bytestring
                    , text
                    , containers
                    , tasty
                    , tasty-quickcheck
                    , QuickCheck >= 2.14
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N

test-suite occam-test
    import:           warnings
    default-language: GHC2021
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test bench
    other-modules:    Baseline
                    , Benchmark
                    , Fuzz
                    , MutationalFuzz
                    , DependencyChecks
                    , EvaluationChecks
                    , OracleChecks
                    , ReductionChecks
    main-is:          Spec.hs
    build-depends:    base >= 4.18 && < 5
                    , occam
                    , bytestring
                    , text
                    , containers
                    , directory
                    , filepath
                    , process
                    , optparse-applicative
                    , tasty
                    , tasty-hunit
                    , tasty-quickcheck
                    , QuickCheck
                    , time
                    , aeson
    ghc-options:      -threaded -rtsopts
